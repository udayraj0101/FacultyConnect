PORT=5000
MONGODB_URI=mongodb://localhost:27017/facultyconnect_dev

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-48-byte-hex
JWT_REFRESH_SECRET=replace-me-different-48-byte-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ORCID sandbox — register at https://orcid.org/developer-tools
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Must match exactly what you registered at sandbox.orcid.org/developer-tools.
# ORCID sandbox rejects "localhost" so we use 127.0.0.1.
ORCID_REDIRECT_URI=http://127.0.0.1:5000/v1/auth/orcid/callback
ORCID_API_BASE=https://sandbox.orcid.org
ORCID_PUBLIC_API_BASE=https://pub.sandbox.orcid.org
# Comma-separated list of allowed frontend origins. Used both to scope CORS
# and (first entry) as the redirect base for the ORCID OAuth callback.
FRONTEND_URL=http://localhost:5173

# Elsevier / Scopus — register at https://dev.elsevier.com/apikey/manage
# Free tier: 5000 requests/week for Author Retrieval + Abstract Retrieval.
ELSEVIER_API_KEY=
SCOPUS_API_BASE=https://api.elsevier.com

LOG_LEVEL=debug

# --- Email delivery ---
# console = log to stdout (dev default). smtp = real delivery via nodemailer.
EMAIL_TRANSPORT=console
EMAIL_FROM=FacultyConnect <info@digifusion.in>
EMAIL_HOST=
# Common defaults: Google Workspace 587 (STARTTLS), 465 (SSL). cPanel usually 587.
EMAIL_PORT=587
EMAIL_USER=info@digifusion.in
EMAIL_PASS=

# --- Scheduler ---
# Off by default in dev so cron doesn't hammer local Mongo. Set to true in prod.
ENABLE_SCHEDULER=false
SCHEDULER_TIMEZONE=Asia/Kolkata

# --- Public profile SEO ---
# Absolute origin used in canonical URLs and sitemap. Falls back to request Host if unset.
PUBLIC_BASE_URL=
